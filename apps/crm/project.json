{
  "name": "crm",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/crm/src",
  "tags": [
    "type:app",
    "scope:crm"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/crm",
        "browser": "apps/crm/src/main.ts",
        "tsConfig": "apps/crm/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/crm/public"
          }
        ],
        "styles": [
          "apps/crm/src/styles.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "800kb",
              "maximumError": "1.2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/crm/src/environments/environment.ts",
              "with": "apps/crm/src/environments/environment.development.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "crm:build:production"
        },
        "development": {
          "buildTarget": "crm:build:development"
        }
      },
      "options": {
        "proxyConfig": "apps/crm/proxy.conf.json"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": [
        "build"
      ],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "crm:build",
        "port": 4200,
        "staticFilePath": "dist/apps/crm/browser",
        "spa": true
      }
    }
  }
}
